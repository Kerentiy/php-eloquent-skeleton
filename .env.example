APP_NAME="PHP Eloquent Skeleton"
APP_ENV=local
APP_DEBUG=true

# --- Database (sqlite | mysql) ---
DB_CONNECTION=sqlite
# For sqlite: path relative to the project root (or absolute / ":memory:")
DB_DATABASE=database/database.sqlite
# For mysql:
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=

# --- Logging (Monolog) ---
LOG_PATH=storage/logs
LOG_LEVEL=debug
LOG_MAX_FILES=14
# Log executed SQL queries (level DEBUG, channel "app")
LOG_QUERIES=true
# Max number of bytes of request/response body written to the log
LOG_BODY_MAX_BYTES=10240
